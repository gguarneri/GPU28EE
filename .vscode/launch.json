{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cuda_app (Project Template)",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/proj_template/build/bin/cuda_app",
        },
        {
            "name": "Soma vetores",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sum_vectors/build/bin/sum_vectors",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/sum_vectors",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "cuda-gdb", // Aponta para o gdb da Nvidia
            "setupCommands": [
                {
                    "description": "Habilitar impressão bonita para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        },
    ]
}
